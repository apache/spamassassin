###########################################################################

# Tell SA to use Bayes/Redis backend
bayes_store_module  Mail::SpamAssassin::BayesStore::Redis

#
# Redis Bayes Configuration
#
# This new version supports separate read and write servers for better scalability
# and high availability. You can configure multiple read servers for load balancing
# and failover, while maintaining a single write server for data consistency.
#

#
# New Configuration Method (Recommended)
#
# For production environments with Redis replication, use separate read/write servers:

# Multiple read servers (Redis replicas) - comma-separated list
# SpamAssassin will automatically fail over to the next server if one becomes unavailable
bayes_redis_read_servers   server=192.168.1.3;port=6379,server=192.168.1.4;port=6379

# Single write server (Redis primary) - ensures data consistency
bayes_redis_write_server   server=192.168.1.2;port=6379

# Redis database number to use (default: 0)
bayes_redis_database       0

# Redis authentication password (if required)
# bayes_redis_password       your_redis_password

# Key prefix for namespacing (useful when sharing Redis with other applications)
# bayes_redis_prefix         bayes:

#
# Alternative: Single Server Configuration
#
# For simple deployments with a single Redis server, use the same server for both:
# bayes_redis_read_servers   server=192.168.1.2;port=6379
# bayes_redis_write_server   server=192.168.1.2;port=6379

#
# Legacy Configuration Method (Still Supported)
#
# For backward compatibility, you can still use the old DSN format:
# bayes_sql_dsn  server=192.168.1.2:6379;database=0;password=your_password
#
# NOTE: If both new and legacy configurations are present, the new configuration
# parameters will take precedence.

#
# Bayes Configuration
#
use_bayes 1
use_bayes_rules 1

# Your choice if you want to use auto_learn
bayes_auto_learn  1

use_learner 1
bayes_learn_to_journal 0



# THIS IS MANDATORY - You do NOT need to run sa-learn to expire tokens
# *_ttl below takes care of it.
bayes_auto_expire  1

# You  will need to changes this according to your need
# This replaces sa-learn's sql/file based expire routines.
bayes_token_ttl 30d
bayes_seen_ttl  14d

