body __PHONESCAM_859_204  /(?<![0-9=])(?![0-9]{10})(?:\+?<1><PSEP>)?(?:\(<8><5><9>\)|<8><5><9>)<PSEP><2><ZERO><4><PSEP><6><9><8>(?:<ZERO>|<4>)(?![0-9=])/
