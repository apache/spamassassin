body __PHONESCAM_813_776  /(?<![0-9=])(?![0-9]{10})(?:\+?<1><PSEP>)?(?:\(<8><1><3>\)|<8><1><3>)<PSEP><7><7><6><PSEP><1><4>(?:<ZERO>|<1>)<ZERO>(?![0-9=])/
replace_rules __PHONESCAM_813_776

