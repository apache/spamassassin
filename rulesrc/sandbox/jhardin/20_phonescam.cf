body __PHONESCAM_838_209  /(?<![0-9=])(?![0-9]{10})(?:\+?<1><PSEP>)?(?:\(<8><3><8>\)|<8><3><8>)<PSEP><2><ZERO><9><PSEP><ZERO><1><8>(?:<7>|<8>)(?![0-9=])/
replace_rules __PHONESCAM_838_209

