body __PHONESCAM_812_266  /(?<![0-9=])(?![0-9]{10})(?:\+?<1><PSEP>)?(?:\(<8><1><2>\)|<8><1><2>)<PSEP><2><6><6><PSEP><1>(?:<5><1>|<8><9>)<ZERO>(?![0-9=])/
replace_rules __PHONESCAM_812_266

